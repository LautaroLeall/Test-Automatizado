{
  "info": {
    "name": "JSONPlaceholder TP3",
    "description": "TP3 Test de Integracion - GET, POST, PUT, DELETE",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET Post",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 (GET)\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has userId\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('userId');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{url}}/posts/{{postId}}",
          "host": [
            "{{url}}"
          ],
          "path": [
            "posts",
            "{{postId}}"
          ]
        }
      }
    },
    {
      "name": "POST Post",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 (POST)\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response contains id 101\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.eql(101);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-type",
            "value": "application/json; charset=UTF-8"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"foo\",\n  \"body\": \"bar\",\n  \"userId\": 1\n}"
        },
        "url": {
          "raw": "{{url}}/posts",
          "host": [
            "{{url}}"
          ],
          "path": [
            "posts"
          ]
        }
      }
    },
    {
      "name": "PUT Post",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 (PUT)\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-type",
            "value": "application/json; charset=UTF-8"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 1,\n  \"title\": \"foo update\",\n  \"body\": \"bar update\",\n  \"userId\": 1\n}"
        },
        "url": {
          "raw": "{{url}}/posts/{{postId}}",
          "host": [
            "{{url}}"
          ],
          "path": [
            "posts",
            "{{postId}}"
          ]
        }
      }
    },
    {
      "name": "PATCH Post",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 (PATCH)\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Title was updated\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.title).to.eql(\"patched title\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-type",
            "value": "application/json; charset=UTF-8"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"patched title\"\n}"
        },
        "url": {
          "raw": "{{url}}/posts/{{postId}}",
          "host": [
            "{{url}}"
          ],
          "path": [
            "posts",
            "{{postId}}"
          ]
        }
      }
    },
    {
      "name": "DELETE Post",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 (DELETE)\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{url}}/posts/{{postId}}",
          "host": [
            "{{url}}"
          ],
          "path": [
            "posts",
            "{{postId}}"
          ]
        }
      }
    }
  ]
}
